# Modelo: proveedor/modelo  (ollama/llama3.1:8b-instruct-q4_K_M | gemini/gemini-2.5-flash)
MODELO=ollama/llama3.1:8b-instruct-q4_K_M

# Varias claves Gemini separadas por comas (se elige con --key N si se agota la cuota)
GOOGLE_API_KEYS=key1,key2,key3

# Servidor MCP (HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Directorios
BASE_DIR=data/descargas
RECEPCION_DIR=data/recepcion

# Ollama (docker compose)
OLLAMA_BASE_URL=http://localhost:11434
TEMAS=tecnología,deportes,cocina,finanzas,salud,otros
