# Proveedor por defecto: ollama | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct-q4_K_M

# Varias claves Gemini separadas por comas (rotación si se agota la cuota)
GOOGLE_API_KEYS=key1,key2,key3

# Servidor MCP (HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Directorios
BASE_DIR=data/descargas
RECEPCION_DIR=data/recepcion

# Ollama (docker compose)
OLLAMA_BASE_URL=http://localhost:11434
TEMAS=tecnología,deportes,cocina,finanzas,salud,otros
